{
	"schemaVersion": 1,
	"id": "arceon",
	"version": "${version}",
	"name": "Arceon x Axiom",
	"description": "Implements Arceon features into Axiom",
	"authors": [
		"Arcaniax"
	],
	"contact": {
		"homepage": "https://www.patreon.com/c/arcaniax"
	},
	"license": "All-Rights-Reserved",
	"icon": "assets/arceon/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"net.arcaniax.arceon.axiom.ArceonClient"
		]
	},
	"mixins": [
		"arceon.mixins.json",
		{
			"config": "arceon.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.14.21",
		"minecraft": "${minecraft_dependency}",
		"java": ">=21",
		"fabric-api": "*"
	},
	"requires": {
		"axiom": ">=5.4.2"
	}
}
